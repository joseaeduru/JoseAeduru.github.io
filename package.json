{
  "name": "joseaeduru-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:build": "node --test \"tests/build/*.test.mjs\"",
    "check": "node scripts/check-content.mjs",
    "check:public": "node scripts/check-content.mjs --public-only",
    "verify": "npm test && astro build && npm run test:build && npm run check",
    "build:ci": "npm test && astro build && npm run test:build && npm run check:public"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.3.7"
  }
}
