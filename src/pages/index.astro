---
import Base from '../layouts/Base.astro';
import Pills from '../components/Pills.astro';
import {
  site,
  stats,
  about,
  led,
  howIWork,
  skills,
  roles,
  selectedWork,
  certifications,
  education,
} from '../data/profile.mjs';

const title = `${site.name} | ${site.title}, Frisco, TX`;
const number = (index) => String(index + 1).padStart(2, '0');
---

<Base title={title} description={site.description}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="label">{site.name} · {site.title} · {site.subtitle}</p>
        <h1>{site.headline[0]} <em>{site.headline[1]}</em></h1>
        <p class="lead">{about[0]}</p>
        <p class="actions">
          <a class="btn" href={`mailto:${site.email}`}>Email me<span class="arrow" aria-hidden="true">↗</span></a>
          <a class="text-link" href={site.linkedin} rel="noopener">LinkedIn profile<span class="arrow" aria-hidden="true">↗</span></a>
        </p>
        <p class="label hero-focus">{site.focus}</p>
      </div>
      <ul class="hero-stats">
        {
          stats.map((stat) => (
            <li>
              <strong>{stat.value}</strong>
              <span class="label">{stat.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="expertise" class="band-white" aria-labelledby="expertise-h">
    <div class="wrap split">
      <div class="split-aside sticky">
        <p class="label">01 / Expertise</p>
        <h2 id="expertise-h">Techno-functional, <em>across the suite.</em></h2>
        <p class="lead">{about[1]}</p>
      </div>
      <div class="split-main">
        <ul class="rule-list">
          {
            led.map((item) => (
              <li>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="wrap">
      <div class="skills">
        {
          skills.map((group) => (
            <div class="skill-row">
              <p class="label">{group.group}</p>
              <Pills items={group.items} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="work" aria-labelledby="work-h">
    <div class="wrap">
      <div class="section-head">
        <p class="label">02 / Selected work</p>
        <h2 id="work-h">Programs delivered, <em>start to finish.</em></h2>
      </div>
      <ol class="work-list">
        {
          selectedWork.map((work, index) => (
            <li class="work">
              <div class="work-index">
                <span class="work-no">{number(index)}</span>
                <span class="label">{work.area}</span>
              </div>
              <div class="work-body">
                <p class="label">{work.kicker}</p>
                <h3>
                  <span>{work.title[0]}</span>
                  <span>{work.title[1]}</span>
                </h3>
                <p>{work.summary}</p>
                <details>
                  <summary>Project context</summary>
                  <ul class="bullets">
                    {work.details.map((detail) => <li>{detail}</li>)}
                  </ul>
                </details>
              </div>
              <div class="work-stat">
                <p class="stat-value">
                  {work.stat.value}{work.stat.unit && <small>{work.stat.unit}</small>}
                </p>
                <p class="label">{work.stat.label}</p>
                <p class="stat-note">{work.stat.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="experience" class="band-white" aria-labelledby="experience-h">
    <div class="wrap split">
      <div class="split-aside sticky">
        <p class="label">03 / Experience</p>
        <h2 id="experience-h">A career built <em>in delivery.</em></h2>
        <p class="lead">
          From EBS and Cloud migration work to leading enterprise HCM programs and supporting live operations.
        </p>
        <p class="actions">
          <a class="text-link" href="/experience/">Full experience<span class="arrow" aria-hidden="true">↗</span></a>
        </p>
      </div>
      <div class="split-main">
        <ol class="timeline">
          {
            roles.map((role) => (
              <li>
                <p class="label">{role.dates}</p>
                <h3 class="tl-employer">{role.employer}</h3>
                <p class="tl-title">{role.title}</p>
                <p>{role.short}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section id="approach" aria-labelledby="approach-h">
    <div class="wrap split">
      <div class="split-aside">
        <p class="label">04 / Approach</p>
        <h2 id="approach-h">How <em>I work.</em></h2>
      </div>
      <div class="split-main">
        <ol class="rule-list numbered">
          {howIWork.map((point) => <li><span>{point}</span></li>)}
        </ol>
      </div>
    </div>
  </section>

  <section id="credentials" class="band-sage credentials" aria-labelledby="credentials-h">
    <div class="wrap split">
      <div class="split-aside">
        <p class="label">Professional foundation</p>
        <h2 id="credentials-h">Credentials <em>and education.</em></h2>
      </div>
      <div class="split-main">
        <h3>Oracle certifications</h3>
        <ul class="rule-list">
          {certifications.map((certification) => <li>{certification}</li>)}
        </ul>
        <h3>Education</h3>
        <p>{education}</p>
      </div>
    </div>
  </section>
</Base>
