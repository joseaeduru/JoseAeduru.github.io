---
import { site } from '../data/profile.mjs';
import { getPublishedPosts } from '../lib/blog.js';

const hasPosts = (await getPublishedPosts()).length > 0;
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/experience/', label: 'Experience' },
  ...(hasPosts ? [{ href: '/blog/', label: 'Blog' }] : []),
];
const isCurrent = (href) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">{site.name}</a>
    <nav aria-label="Main">
      <ul class="nav-list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li><a class="btn" href={`mailto:${site.email}`}>Email</a></li>
      </ul>
    </nav>
  </div>
  <div class="accent-bar"></div>
</header>
