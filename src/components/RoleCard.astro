---
const { role } = Astro.props;
---

<article class="role" id={role.id}>
  <div class="role-aside">
    <p class="label">{role.dates}</p>
    <p class="role-employer">{role.employer}</p>
    <p class="role-meta">{role.industry} · {role.location}</p>
  </div>
  <div class="role-body">
    <h2>{role.title}</h2>
    <p>{role.summary}</p>
    <ul class="bullets">
      {role.bullets.map((bullet) => <li>{bullet}</li>)}
    </ul>
  </div>
</article>
